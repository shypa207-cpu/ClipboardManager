<Window x:Class="ClipboardManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard Manager"
        Width="360" Height="480"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="OnPreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Кнопка-іконка -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Текстова кнопка в заголовку -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Padding="10,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тонкий скролбар у стилі Win11 -->
        <Style x:Key="ScrollRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ThumbBrush}" CornerRadius="2" Width="4"
                                HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollRepeat}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Контейнер елемента списку -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource Stroke}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSelected}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="OnItemClick"/>
        </Style>

        <!-- Шаблон даних -->
        <DataTemplate x:Key="ClipTemplate">
            <Grid Margin="10,8,6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Текст: 3 рядки з трикрапкою -->
                <TextBlock Grid.Column="0" Text="{Binding Preview}"
                           Visibility="{Binding TextVisibility}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineHeight="18" LineStackingStrategy="BlockLineHeight"
                           MaxHeight="54" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"/>

                <!-- Зображення: мініатюра зі збереженням пропорцій -->
                <Image Grid.Column="0" Source="{Binding Thumbnail}"
                       Visibility="{Binding ImageVisibility}"
                       Stretch="Uniform" StretchDirection="DownOnly"
                       MaxHeight="80" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Grid Grid.Column="1" Width="64" VerticalAlignment="Top" Margin="6,0,0,0">
                    <!-- Індикатор закріплення -->
                    <TextBlock x:Name="PinIndicator" Text="&#xE718;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                               Visibility="{Binding PinnedVisibility}"/>
                    <!-- Дії (на ховері/виділенні) -->
                    <StackPanel x:Name="Actions" Orientation="Horizontal"
                                HorizontalAlignment="Right" Opacity="0">
                        <Button Style="{StaticResource IconButton}" Tag="pin"
                                Content="{Binding PinGlyph}" ToolTip="{Binding PinTip}"/>
                        <Button Style="{StaticResource IconButton}" Tag="delete"
                                Content="&#xE74D;" ToolTip="Видалити"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                    <Setter TargetName="PinIndicator" Property="Opacity" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                    <Setter TargetName="PinIndicator" Property="Opacity" Value="0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8,6,4,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="6,0,6,6">
            <TextBlock Text="Буфер обміну" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button x:Name="ClearBtn" Content="Очистити все" Style="{StaticResource TextButton}"
                    HorizontalAlignment="Right" Click="OnClearAll"/>
        </Grid>

        <!-- Список -->
        <ListBox x:Name="List" Grid.Row="1"
                 Background="Transparent" BorderThickness="0"
                 ItemTemplate="{StaticResource ClipTemplate}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.PanningMode="VerticalOnly"
                 ButtonBase.Click="OnItemButton"
                 Padding="0,0,6,0"/>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Історія порожня.&#x0A;Скопіюйте текст або зображення."
                   TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False"/>
    </Grid>
</Window>
